<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loan Interest Calculator</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        padding: 30px;
    }

    .container {
        max-width: 500px;
        margin: auto;
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    h2 {
        text-align: center;
    }

    input {
        width: 100%;
        padding: 10px;
        margin-top: 10px;
        margin-bottom: 15px;
        font-size: 16px;
    }

    button {
        width: 100%;
        padding: 12px;
        background: #007bff;
        color: white;
        border: none;
        font-size: 16px;
        cursor: pointer;
        border-radius: 5px;
    }

    button:hover {
        background: #0056b3;
    }

    .result {
        margin-top: 20px;
        background: #f9f9f9;
        padding: 15px;
        border-radius: 8px;
    }

    .history {
        margin-top: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
    }

    th {
        background: #007bff;
        color: white;
    }
</style>
</head>
<body>

<div class="container">
    <h2>Loan Calculator</h2>

    <label>Total Amount</label>
    <input type="number" id="totalAmount" value="20000">

    <label>Annual Interest (%)</label>
    <input type="number" id="interestRate" value="4">

    <label>Monthly Deposit</label>
    <input type="number" id="depositAmount" placeholder="Enter deposit">

    <button onclick="calculate()">Pay This Month</button>

    <div class="result" id="result"></div>

    <div class="history">
        <h3>Payment History</h3>

        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Deposit</th>
                    <th>Interest</th>
                    <th>Actual Pay</th>
                    <th>Remaining</th>
                </tr>
            </thead>
            <tbody id="historyTable"></tbody>
        </table>
    </div>
</div>

<script>
    let month = 1;

    function calculate() {

        let totalAmountInput = document.getElementById("totalAmount");
        let interestRate = parseFloat(document.getElementById("interestRate").value);
        let deposit = parseFloat(document.getElementById("depositAmount").value);

        let totalAmount = parseFloat(totalAmountInput.value);

        if (deposit <= 0 || isNaN(deposit)) {
            alert("Enter valid deposit amount");
            return;
        }

        // Monthly interest rate
        let monthlyRate = interestRate / 12 / 100;

        // Floor interest
        let interest = Math.floor(totalAmount * monthlyRate);

        // Actual payment towards principal
        let actualPay = deposit - interest;

        if (actualPay <= 0) {
            alert("Deposit must be greater than interest");
            return;
        }

        // Update remaining amount
        totalAmount -= actualPay;

        if (totalAmount < 0)
            totalAmount = 0;

        // Update input field
        totalAmountInput.value = totalAmount.toFixed(2);

        // Show result
        document.getElementById("result").innerHTML = `
            <p><b>Interest:</b> ${interest}</p>
            <p><b>Actual Pay:</b> ${actualPay.toFixed(2)}</p>
            <p><b>Remaining Amount:</b> ${totalAmount.toFixed(2)}</p>
        `;

        // Add history row
        let row = `
            <tr>
                <td>${month}</td>
                <td>${deposit}</td>
                <td>${interest}</td>
                <td>${actualPay.toFixed(2)}</td>
                <td>${totalAmount.toFixed(2)}</td>
            </tr>
        `;

        document.getElementById("historyTable").innerHTML += row;

        month++;

        // Clear deposit field
        document.getElementById("depositAmount").value = "";

        // Loan complete
        if (totalAmount === 0) {
            alert("Loan Fully Paid!");
        }
    }
</script>

</body>
</html>